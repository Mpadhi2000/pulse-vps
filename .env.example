# Endpoint the dashboard polls. Defaults to the live VPS API (it sends CORS: *).
# When serving the static build from the VPS itself you can use a relative path:
# NEXT_PUBLIC_API_URL=/api/status
NEXT_PUBLIC_API_URL=https://pulse.mayankpadhi.in/api/status

# Only needed for GitHub Pages project sites (set automatically by the workflow).
# NEXT_PUBLIC_BASE_PATH=/pulse-vps
