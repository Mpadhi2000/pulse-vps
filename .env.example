# Origin of the Pulse API (the app calls ${PULSE_API_URL}/api/status). Inlined at build time.
# Must be the VPS, not the Vercel domain the dashboard is served from.
PULSE_API_URL=https://pulse-api.mayankpadhi.in

# Only if the site is served from a sub-path (leave unset on Vercel).
# NEXT_PUBLIC_BASE_PATH=
